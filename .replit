modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
IMAGE_MODEL = "krea/krea-2-medium-turbo"
IMAGE_PROVIDER = "krea"
TTS_PITCH = "+0Hz"
TTS_PROVIDER = "voice_api"
TTS_RATE = "-3%"
TTS_VOICE_ID = "google-ru"
ODIROUTER_IMAGE_MODEL = "free-nano-banana-2"
ODIROUTER_IMAGE_RESOLUTION = "1K"
VOICE_API_MODEL_ID = "eleven_v3"
VOICE_API_VOICE_ID = "BTL5iDLqtiUxgJtpekus"
VOICE_API_TEMPLATE_UUID = "420f65d6-2a3a-475d-b30c-9b99d54713c6"
YOUTUBE_DEFAULT_PRIVACY_STATUS = "private"
YOUTUBE_REDIRECT_URI = "https://94c2dfca-b875-4068-b458-fac212906245-00-2aw0moac0aigb.archer.replit.dev/api/youtube/callback"
FAL_IMAGE_MODEL = "fal-ai/flux/schnell"
SUPABASE_URL = "https://idtgimgwvnbxtwjcjzev.supabase.co"
VOICE_API_URL = "https://voiceapi.csv666.ru"
INSTAGRAM_REDIRECT_URI = "https://94c2dfca-b875-4068-b458-fac212906245-00-2aw0moac0aigb.archer.replit.dev/api/instagram/callback"
SUPABASE_DB_HOST = "aws-1-eu-west-1.pooler.supabase.com"
SUPABASE_DB_NAME = "postgres"
SUPABASE_DB_PORT = "5432"
SUPABASE_DB_USER = "postgres.idtgimgwvnbxtwjcjzev"
LUMEAN_TEMPLATE_ID = "01a0c3c1-1599-7331-846c-2796f7ec3f10"

[nix]
channel = "stable-25_05"
packages = ["yt-dlp"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19842
externalPort = 3000

[[ports]]
localPort = 24034
externalPort = 80
