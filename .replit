modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
IMAGE_MODEL = "google/gemini-3.1-flash-lite-image"
GEMINI_IMAGE_MODEL = "gemini-2.5-flash-image"
IMAGE_PROVIDER = "odirouter"
TTS_PITCH = "+0Hz"
TTS_PROVIDER = "voice_api"
TTS_RATE = "-3%"
TTS_VOICE_ID = "google-ru"
ODIROUTER_IMAGE_MODEL = "free-nano-banana-2"
ODIROUTER_IMAGE_RESOLUTION = "1K"
VOICE_API_MODEL_ID = "eleven_multilingual_v2"
VOICE_API_VOICE_ID = "iP95p4xoKVk53GoZ742B"

[nix]
channel = "stable-25_05"
