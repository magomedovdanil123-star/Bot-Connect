# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Кто может пользоваться ботом: id или @username через запятую. Пусто = все (не рекомендуется — рендер нагружает сервер)
ALLOWED_USERS=
# Озвучка через Lumean (необязательно). Если заданы оба — в боте появится кнопка «Видео с озвучкой»
LUMEAN_KEY=
LUMEAN_TEMPLATE=
# Лимит длины сценария в символах
MAX_SCRIPT_CHARS=8000
